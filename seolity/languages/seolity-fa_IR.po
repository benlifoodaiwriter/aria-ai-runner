msgstr "تنظیمات"

msgid "You are not allowed to access this page."
msgstr "شما اجازه دسترسی به این صفحه را ندارید."

msgid "SEOlity requires JavaScript."
msgstr "سئولیتی به جاوااسکریپت نیاز دارد."

msgid "Forbidden"
msgstr "غیرمجاز"

msgid "Analyze this page"
msgstr "تحلیل این صفحه"

