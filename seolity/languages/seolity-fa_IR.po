msgstr "اسکیما"

msgid "Sitemap"
msgstr "نقشه سایت"

msgid "Robots.txt"
msgstr "Robots.txt"

msgid "Reports"
msgstr "گزارش‌ها"

msgid "Alerts"
msgstr "هشدارها"

