msgstr "همه تصاویر متن ALT دارند."

msgid "No images — visuals improve engagement and can rank in Image Search."
msgstr "بدون تصویر — تصاویر تعامل را افزایش می‌دهند و می‌توانند در جستجوی تصاویر رتبه بگیرند."

msgid "Text is easy to read."
msgstr "متن خوانا است."

msgid "Shorten long sentences and paragraphs; use lists for steps and specs."
msgstr "جملات و پاراگراف‌های طولانی را کوتاه کنید؛ برای مراحل و مشخصات از فهرست استفاده کنید."

#, php-format
msgid "%1$d words (recommended ≥ %2$d for this type) — depth score reflects coverage, structure and supporting elements, not length alone."
msgstr "%1$d کلمه (برای این نوع ≥ %2$d توصیه می‌شود) — امتیاز عمق، پوشش، ساختار و عناصر پشتیبان را می‌سنجد، نه فقط طول را."

#, php-format
msgid "Covers %1$d of %2$d related terms/subtopics."
msgstr "%1$d از %2$d اصطلاح/زیرموضوع مرتبط را پوشش می‌دهد."

#, php-format
msgid "Mentions %1$d of %2$d key entities."
msgstr "به %1$d از %2$d موجودیت کلیدی اشاره می‌کند."

#, php-format
msgid "Content format vs. \"%s\" search intent."
msgstr "قالب محتوا در برابر هدف جستجوی «%s»."

msgid "Several sentences are repeated — remove boilerplate to increase information gain."
msgstr "چند جمله تکرار شده‌اند — متن‌های تکراری را حذف کنید تا ارزش اطلاعاتی افزایش یابد."

msgid "Search Console data"
msgstr "داده‌های سرچ کنسول"

msgid "Crawl of the whole site"
msgstr "خزش کل سایت"

msgid "Issues and opportunities"
msgstr "مشکلات و فرصت‌ها"

msgid "404 redirect targets"
msgstr "مقصدهای ریدایرکت ۴۰۴"

msgid "AI roadmap"
msgstr "مسیر راه هوش مصنوعی"

msgid "Not connected — skipped."
msgstr "متصل نیست — رد شد."

msgid "Last days updated."
msgstr "روزهای اخیر به‌روز شد."

msgid "Crawling…"
msgstr "در حال خزش…"

#, php-format
msgid "%d pages checked so far…"
msgstr "تا اینجا %d صفحه بررسی شد…"

#, php-format
msgid "%d pages crawled"
msgstr "%d صفحه خزش شد"

msgid "The crawl did not finish; the other sections use the latest available data."
msgstr "خزش تمام نشد؛ بخش‌های دیگر از آخرین داده موجود استفاده می‌کنند."

#, php-format
msgid "%d findings"
msgstr "%d یافته"

#, php-format
msgid "%d groups"
msgstr "%d گروه"

msgid "No AI engine — slug matching only."
msgstr "موتور هوش مصنوعی نیست — فقط تطبیق نامک."

msgid "Running in the background."
msgstr "در پس‌زمینه در حال اجراست."

msgid "The AI is writing the roadmap in the background."
msgstr "هوش مصنوعی در پس‌زمینه مسیر راه را می‌نویسد."

#, php-format
msgid "All sections updated. %d open items in the roadmap."
msgstr "همه بخش‌ها به‌روز شد. %d مورد باز در مسیر راه."

msgid "Some sections could not be updated — see the details."
msgstr "بعضی بخش‌ها به‌روز نشدند — جزئیات را ببینید."

msgid "Your AI subscription is working on this request on GitHub…"
msgstr "اشتراک هوش مصنوعی شما در حال انجام این درخواست روی گیت‌هاب است…"

msgid "Unexpected error."
msgstr "خطای غیرمنتظره."

msgid "Sorry, you are not allowed to do that."
msgstr "متأسفیم، اجازهٔ انجام این کار را ندارید."

msgid "Operation not found."
msgstr "عملیات پیدا نشد."

msgid "Invalid status."
msgstr "وضعیت نامعتبر است."

msgid "You can only manage your own tasks."
msgstr "فقط وظایف خودتان را می‌توانید مدیریت کنید."

msgid "Change not found."
msgstr "تغییر پیدا نشد."

msgid "Only URLs of this site can be tested."
msgstr "فقط URLهای همین سایت قابل آزمایش هستند."

msgid "This property is not available for the connected account."
msgstr "این پراپرتی برای حساب متصل در دسترس نیست."

msgid "You are not allowed to edit this product."
msgstr "شما اجازه ویرایش این محصول را ندارید."

msgid "Select between 1 and 200 URLs."
msgstr "بین ۱ تا ۲۰۰ آدرس انتخاب کنید."

msgid "None of the selected URLs were found."
msgstr "هیچ‌کدام از آدرس‌های انتخاب‌شده پیدا نشد."

#, php-format
msgid "Redirect %d broken URLs to their suggested pages"
msgstr "ریدایرکت %d آدرس خراب به صفحات پیشنهادی"

msgid "Unknown secret."
msgstr "کلید محرمانه ناشناخته."

msgid "auth.json must be valid JSON (copy the whole file from ~/.codex/auth.json)."
msgstr "auth.json باید JSON معتبر باشد (کل فایل ~/.codex/auth.json را کپی کنید)."

msgid "This host does not allow PHP to start programs (proc_open is disabled). Subscriptions can only run through GitHub here."
msgstr "این هاست اجازه اجرای برنامه به PHP نمی‌دهد (proc_open غیرفعال است). اینجا اشتراک فقط از طریق گیت‌هاب کار می‌کند."

msgid "Claude Code CLI was not found on this server. Install it (npm install -g @anthropic-ai/claude-code) or enter its full path."
msgstr "ابزار Claude Code روی این سرور پیدا نشد. نصبش کنید (npm install -g @anthropic-ai/claude-code) یا مسیر کاملش را وارد کنید."

msgid "Codex CLI was not found on this server. Install it (npm install -g @openai/codex) or enter its full path."
msgstr "ابزار Codex روی این سرور پیدا نشد. نصبش کنید (npm install -g @openai/codex) یا مسیر کاملش را وارد کنید."

msgid "Save your subscription login first (Settings → AI)."
msgstr "اول ورود اشتراک را ذخیره کنید (تنظیمات ← هوش مصنوعی)."

msgid "Dates must be YYYY-MM-DD."
msgstr "تاریخ‌ها باید به‌صورت YYYY-MM-DD باشند."

#, php-format
msgid "%1$s clicks this week (%2$s%%)"
msgstr "%1$s کلیک در این هفته (%2$s%%)"

#, php-format
msgid "Impressions %3$s, avg. position %4$s."
msgstr "نمایش‌ها %3$s، میانگین جایگاه %4$s."

#, php-format
msgid "Rising: %1$s (+%2$d clicks)"
msgstr "در حال رشد: %1$s (+%2$d کلیک)"

#, php-format
msgid "Falling: %1$s (%2$d clicks)"
msgstr "در حال افت: %1$s (%2$d کلیک)"

#, php-format
msgid "%d new issue types detected in the last audit"
msgstr "%d نوع مشکل جدید در آخرین ممیزی شناسایی شد"

#, php-format
msgid "Experiment \"%1$s\": %2$s"
msgstr "آزمایش «%1$s»: %2$s"

#, php-format
msgid "Organic clicks %s%% week over week"
msgstr "کلیک‌های ارگانیک %s%% نسبت به هفته قبل"

msgid "Your daily SEO briefing"
msgstr "گزارش روزانه سئوی شما"

#, php-format
msgid "Health score %1$s. %2$d prioritized actions are waiting, %3$d AI changes need your review."
msgstr "امتیاز سلامت %1$s. %2$d اقدام اولویت‌دار در انتظار است و %3$d تغییر هوش مصنوعی نیاز به بررسی شما دارد."

msgid "Please type a question."
msgstr "لطفاً یک سؤال بنویسید."

msgid "Reading your site data…"
msgstr "خواندن اطلاعات سایت شما…"

msgid "Message not found."
msgstr "پیام پیدا نشد."

msgid "Chat answer (again)"
msgstr "پاسخ چت (دوباره)"

msgid "Enter a valid domain, e.g. example.com"
msgstr "یک دامنه معتبر وارد کنید، مثلاً example.com"

msgid "This domain does not resolve to a public address."
msgstr "این دامنه به یک آدرس عمومی اشاره نمی‌کند."

msgid "Competitor not found."
msgstr "رقیب پیدا نشد."

msgid "This field cannot be changed by SEOlity."
msgstr "این فیلد توسط سئولیتی قابل تغییر نیست."

msgid "Object not found."
msgstr "مورد پیدا نشد."

msgid "Suggested value is identical to the current value."
msgstr "مقدار پیشنهادی با مقدار فعلی یکسان است."

msgid "Could not store the change."
msgstr "ذخیره تغییر ممکن نشد."

msgid "This change is no longer pending."
msgstr "این تغییر دیگر در انتظار نیست."

msgid "Only applied changes can be reverted."
msgstr "فقط تغییرات اعمال‌شده قابل بازگشت هستند."

#, php-format
msgid "A page with organic traffic was trashed: %s"
msgstr "صفحه‌ای با ترافیک ارگانیک به زباله‌دان منتقل شد: %s"

#, php-format
msgid "It received %1$d clicks in the last 28 days and has %2$d internal links. Add a 301 redirect to the closest relevant page to keep its value."
msgstr "این صفحه در ۲۸ روز گذشته %1$d کلیک گرفته و %2$d لینک داخلی دارد. برای حفظ ارزش آن، به نزدیک‌ترین صفحه مرتبط ریدایرکت ۳۰۱ بزنید."

#, php-format
msgid "Reading %d blog articles…"
msgstr "خواندن %d مقاله وبلاگ…"

msgid "Comparing articles…"
msgstr "مقایسه مقالات…"

#, php-format
msgid "Most Search Console clicks (%d in 90 days)."
msgstr "بیشترین کلیک در سرچ کنسول (%d در ۹۰ روز)."

#, php-format
msgid "Most internal links pointing to it (%d)."
msgstr "بیشترین لینک داخلی به آن (%d)."

#, php-format
msgid "Most complete article (%d words)."
msgstr "کامل‌ترین مقاله (%d کلمه)."

msgid "Duplicate articles"
msgstr "مقالات تکراری"

msgid "Near-duplicate articles"
msgstr "مقالات شبه تکراری"

msgid "Articles competing for the same topic"
msgstr "مقالاتی که برای یک موضوع با هم رقابت می‌کنند"

#, php-format
msgid "%1$s: %2$s"
msgstr "%1$s: %2$s"

msgid "Several articles answer the same question, so Google splits rankings, links and clicks between them. Merging them into the strongest one usually lifts it."
msgstr "چند مقاله به یک پرسش پاسخ می‌دهند، پس گوگل رتبه، لینک‌ها و کلیک‌ها را بین آن‌ها تقسیم می‌کند. ادغام آن‌ها در قوی‌ترین مقاله معمولاً آن را بالا می‌برد."

msgid "This group was not found — run the scan again."
msgstr "این گروه پیدا نشد — بررسی را دوباره اجرا کنید."

msgid "The primary article must be one of the group."
msgstr "مقاله اصلی باید یکی از اعضای گروه باشد."

msgid "Choose at least one article to merge into the primary."
msgstr "حداقل یک مقاله برای ادغام در مقاله اصلی انتخاب کنید."

msgid "Connect an AI engine first (Settings → AI)."
msgstr "اول یک موتور هوش مصنوعی وصل کنید (تنظیمات ← هوش مصنوعی)."

#, php-format
msgid "Merge into “%s”"
msgstr "ادغام در «%s»"

msgid "Preparing the merge"
msgstr "آماده کردن ادغام"

msgid "The articles no longer exist."
msgstr "این مقالات دیگر وجود ندارند."

msgid "AI is merging the articles…"
msgstr "هوش مصنوعی در حال ادغام مقالات است…"

msgid "The AI returned a merged article much shorter than the primary one, so nothing was prepared. Try again or add instructions."
msgstr "هوش مصنوعی مقاله ادغام‌شده‌ای بسیار کوتاه‌تر از مقاله اصلی برگرداند، پس چیزی آماده نشد. دوباره امتحان کنید یا دستورالعمل اضافه کنید."

msgid "Preparing the preview…"
msgstr "آماده کردن پیش‌نمایش…"

#, php-format
msgid "Merged with %d competing article(s)."
msgstr "با %d مقاله رقیب ادغام شد."

msgid "The merged article could not be prepared."
msgstr "مقاله ادغام‌شده آماده نشد."

msgid "Merged into the primary article: keep it out of the index and the sitemap (it is not deleted)."
msgstr "در مقاله اصلی ادغام شد: از ایندکس و نقشه سایت خارج می‌شود (حذف نمی‌شود)."

msgid "Internal link now points straight at the merged article."
msgstr "لینک داخلی اکنون مستقیم به مقاله ادغام‌شده اشاره می‌کند."

#, php-format
msgid "From %1$s: %2$s"
msgstr "از %1$s: %2$s"

msgid "Left out:"
msgstr "کنار گذاشته شد:"

msgid "Order: merged article first; the old articles get noindex, a 301 and updated internal links only after the merge was saved and verified. Nothing is deleted and every edit keeps a WordPress revision."
msgstr "ترتیب: اول مقاله ادغام‌شده؛ مقالات قدیمی فقط بعد از ذخیره و تأیید ادغام، noindex، ریدایرکت ۳۰۱ و لینک‌های داخلی به‌روز می‌گیرند. هیچ چیز حذف نمی‌شود و هر ویرایش یک نسخه بازبینی وردپرس دارد."

msgid "FAQ must be valid JSON."
msgstr "سؤالات متداول باید JSON معتبر باشد."

msgid "Term not found."
msgstr "دسته/برچسب پیدا نشد."

msgid "There is no content to optimize yet. Write a draft or use \"Generate\"."
msgstr "هنوز محتوایی برای بهینه‌سازی وجود ندارد. یک پیش‌نویس بنویسید یا از «تولید» استفاده کنید."

msgid "Unknown bulk task."
msgstr "عملیات گروهی ناشناخته."

msgid "FAQ generated from page content and real question queries."
msgstr "سؤالات متداول از محتوای صفحه و کوئری‌های سؤالی واقعی تولید شد."

msgid "Page has an empty title, so no H1 / title tag is generated."
msgstr "صفحه عنوان خالی دارد، بنابراین H1 / تگ عنوان تولید نمی‌شود."

msgid "SEOlity Client"
msgstr "مشتری سئولیتی"

msgid "Stopped without finishing (closed by the 1.9 update: this work was no longer running)."
msgstr "بدون اتمام متوقف شد (با به‌روزرسانی ۱.۹ بسته شد: این کار دیگر در حال اجرا نبود)."

msgid "Pages returning 4xx errors"
msgstr "صفحات با خطای 4xx"

msgid "Broken pages waste crawl budget, lose link equity and frustrate users."
msgstr "صفحات خراب بودجه خزش را هدر می‌دهند، اعتبار لینک را از بین می‌برند و کاربران را ناامید می‌کنند."

msgid "Restore the page or 301-redirect it to the closest relevant URL; update internal links."
msgstr "صفحه را بازیابی کنید یا به نزدیک‌ترین URL مرتبط ریدایرکت ۳۰۱ بزنید؛ لینک‌های داخلی را به‌روز کنید."

msgid "Pages returning server errors (5xx)"
msgstr "صفحات با خطای سرور (5xx)"

msgid "Repeated 5xx responses make Google crawl less and can drop pages from the index."
msgstr "خطاهای مکرر 5xx باعث کاهش خزش گوگل می‌شود و ممکن است صفحات از ایندکس حذف شوند."

msgid "Check PHP error logs, hosting resources and plugin conflicts."
msgstr "گزارش خطاهای PHP، منابع هاست و تداخل افزونه‌ها را بررسی کنید."

msgid "Temporary (302/307) redirects"
msgstr "ریدایرکت‌های موقت (302/307)"

msgid "Temporary redirects signal the move is not permanent; signals may not consolidate."
msgstr "ریدایرکت موقت نشان می‌دهد انتقال دائمی نیست؛ ممکن است سیگنال‌ها تجمیع نشوند."

msgid "Use 301 for permanent moves."
msgstr "برای انتقال دائمی از ۳۰۱ استفاده کنید."

msgid "Redirect chains"
msgstr "زنجیره‌های ریدایرکت"

msgid "Each hop adds latency and Google may stop following long chains."
msgstr "هر پرش تأخیر اضافه می‌کند و گوگل ممکن است زنجیره‌های طولانی را دنبال نکند."

msgid "Point the first URL directly at the final destination."
msgstr "URL اول را مستقیماً به مقصد نهایی هدایت کنید."

msgid "Redirect loops"
msgstr "حلقه‌های ریدایرکت"

msgid "Loops make pages completely inaccessible."
msgstr "حلقه‌ها صفحات را کاملاً غیرقابل دسترس می‌کنند."

msgid "Break the loop by fixing or deleting one of the redirects."
msgstr "با اصلاح یا حذف یکی از ریدایرکت‌ها حلقه را بشکنید."

msgid "Noindex pages"
msgstr "صفحات نوایندکس"

msgid "These pages are excluded from Google. That is fine for utility pages but harmful for pages meant to rank."
msgstr "این صفحات از گوگل حذف شده‌اند. برای صفحات کاربردی اشکالی ندارد اما برای صفحاتی که باید رتبه بگیرند مضر است."

msgid "Confirm each noindex is intentional."
msgstr "مطمئن شوید هر نوایندکس عمدی است."

msgid "Noindex pages that still earn search impressions"
msgstr "صفحات نوایندکسی که هنوز در جستجو نمایش دارند"

msgid "A page Google still shows is set to noindex — traffic will be lost when Google re-crawls it."
msgstr "صفحه‌ای که گوگل هنوز نمایش می‌دهد نوایندکس شده — با خزش مجدد گوگل ترافیک آن از دست می‌رود."

msgid "Remove noindex if the page should rank."
msgstr "اگر صفحه باید رتبه بگیرد، نوایندکس را بردارید."

msgid "Noindex URLs listed in the XML sitemap"
msgstr "URLهای نوایندکس در نقشه سایت XML"

msgid "Conflicting signals: the sitemap asks Google to index a page that says noindex."
msgstr "سیگنال‌های متناقض: نقشه سایت از گوگل می‌خواهد صفحه‌ای را ایندکس کند که نوایندکس است."

msgid "Remove these URLs from the sitemap or remove the noindex."
msgstr "این URLها را از نقشه سایت حذف کنید یا نوایندکس را بردارید."

msgid "Published pages blocked by robots.txt"
msgstr "صفحات منتشرشده مسدود توسط robots.txt"

msgid "Google cannot crawl blocked pages, so their content cannot rank."
msgstr "گوگل نمی‌تواند صفحات مسدود را خزش کند، پس محتوای آن‌ها رتبه نمی‌گیرد."

msgid "Adjust robots.txt rules (SEOlity → Robots)."
msgstr "قوانین robots.txt را اصلاح کنید (سئولیتی ← Robots)."

msgid "Pages with meta nofollow"
msgstr "صفحات دارای متای نوفالو"

msgid "Links on these pages pass no signals to the rest of the site."
msgstr "لینک‌های این صفحات هیچ سیگنالی به بقیه سایت منتقل نمی‌کنند."

msgid "Remove nofollow unless intentional."
msgstr "اگر عمدی نیست، نوفالو را بردارید."

msgid "Missing canonical tag"
msgstr "تگ کنونیکال وجود ندارد"

msgid "Without a canonical, URL variants (parameters, trailing slashes) can be indexed as duplicates."
msgstr "بدون کنونیکال، نسخه‌های مختلف URL (پارامترها، اسلش انتهایی) ممکن است به‌عنوان تکراری ایندکس شوند."

msgid "Add a self-referencing canonical."
msgstr "یک کنونیکال خودارجاع اضافه کنید."

msgid "Multiple canonical tags"
msgstr "چند تگ کنونیکال"

msgid "Google ignores conflicting canonicals."
msgstr "گوگل کنونیکال‌های متناقض را نادیده می‌گیرد."

msgid "Make sure only one plugin/theme outputs a canonical."
msgstr "مطمئن شوید فقط یک افزونه/قالب کنونیکال خروجی می‌دهد."

msgid "Relative or invalid canonical URL"
msgstr "URL کنونیکال نسبی یا نامعتبر"

msgid "Canonicals should be absolute URLs."
msgstr "کنونیکال باید URL مطلق باشد."

msgid "Use the absolute URL."
msgstr "از URL مطلق استفاده کنید."

msgid "Canonical points to a redirect or error page"
msgstr "کنونیکال به صفحه ریدایرکت یا خطا اشاره می‌کند"

msgid "Google will likely ignore it and may choose another canonical."
msgstr "گوگل احتمالاً آن را نادیده گرفته و کنونیکال دیگری انتخاب می‌کند."

msgid "Point the canonical at a 200, indexable URL."
msgstr "کنونیکال را به یک URL قابل ایندکس با کد ۲۰۰ اشاره دهید."

msgid "Canonicalized to another URL"
msgstr "کنونیکال به URL دیگر"

msgid "This URL declares another URL as the primary version."
msgstr "این URL، URL دیگری را نسخه اصلی معرفی می‌کند."

msgid "Verify the canonical target is correct."
msgstr "از درستی مقصد کنونیکال مطمئن شوید."

msgid "No XML sitemap found"
msgstr "نقشه سایت XML پیدا نشد"

msgid "Sitemaps help Google discover and prioritize URLs."
msgstr "نقشه سایت به گوگل در کشف و اولویت‌بندی URLها کمک می‌کند."

msgid "Enable SEOlity sitemaps or your SEO plugin sitemap and submit it in GSC."
msgstr "نقشه سایت سئولیتی یا افزونه سئوی خود را فعال و در سرچ کنسول ثبت کنید."

msgid "Sitemap lists redirects or broken URLs"
msgstr "نقشه سایت شامل ریدایرکت یا URL خراب است"

msgid "Sitemaps should only list canonical, 200, indexable URLs."
msgstr "نقشه سایت فقط باید شامل URLهای کنونیکال، با کد ۲۰۰ و قابل ایندکس باشد."

msgid "Exclude these URLs from the sitemap."
msgstr "این URLها را از نقشه سایت حذف کنید."

msgid "robots.txt does not reference the sitemap"
msgstr "robots.txt به نقشه سایت اشاره نمی‌کند"

msgid "Listing the sitemap in robots.txt helps all crawlers find it."
msgstr "معرفی نقشه سایت در robots.txt به همه خزنده‌ها کمک می‌کند آن را پیدا کنند."

msgid "Add a Sitemap: line."
msgstr "یک خط Sitemap: اضافه کنید."

msgid "Missing title tag"
msgstr "تگ عنوان وجود ندارد"

msgid "The title is the strongest on-page relevance signal and the SERP headline."
msgstr "عنوان قوی‌ترین سیگنال ارتباط در صفحه و تیتر نتیجه جستجو است."

msgid "Write a unique, descriptive title."
msgstr "یک عنوان یکتا و توصیفی بنویسید."

msgid "Title too long (truncated in SERP)"
msgstr "عنوان بیش از حد طولانی (در نتایج بریده می‌شود)"

msgid "Truncated titles hide your value proposition and lower CTR."
msgstr "عنوان‌های بریده‌شده ارزش پیشنهادی شما را پنهان و CTR را کم می‌کنند."

msgid "Keep titles under ~580px / 60 characters."
msgstr "عنوان‌ها را زیر حدود ۵۸۰ پیکسل / ۶۰ نویسه نگه دارید."

msgid "Title too short"
msgstr "عنوان بیش از حد کوتاه"

msgid "Short titles miss qualifiers searchers look for."
msgstr "عنوان‌های کوتاه توصیف‌کننده‌هایی که جستجوگران دنبالش هستند را ندارند."

msgid "Add a benefit, qualifier or year."
msgstr "یک مزیت، توصیف‌کننده یا سال اضافه کنید."

msgid "Multiple <title> tags"
msgstr "چند تگ <title>"

msgid "Usually a theme/plugin conflict."
msgstr "معمولاً ناشی از تداخل قالب/افزونه است."

msgid "Ensure only one title is output."
msgstr "مطمئن شوید فقط یک عنوان خروجی داده می‌شود."

msgid "Duplicate titles"
msgstr "عنوان‌های تکراری"

msgid "Duplicate titles make pages compete and confuse Google."
msgstr "عنوان‌های تکراری صفحات را رقیب هم می‌کنند و گوگل را سردرگم می‌کنند."

msgid "Make every title unique."
msgstr "هر عنوان را یکتا کنید."

msgid "Missing meta description"
msgstr "توضیحات متا وجود ندارد"

msgid "Google writes its own snippet, often lowering CTR."
msgstr "گوگل خلاصه خودش را می‌نویسد که اغلب CTR را کاهش می‌دهد."

msgid "Write a compelling 120–158 character description."
msgstr "یک توضیح جذاب ۱۲۰ تا ۱۵۸ نویسه‌ای بنویسید."

msgid "Meta description too short or too long"
msgstr "توضیحات متا خیلی کوتاه یا خیلی بلند"

msgid "Short descriptions under-sell; long ones get cut off."
msgstr "توضیحات کوتاه ارزش را کامل نمی‌رسانند و بلندها بریده می‌شوند."

msgid "Aim for 120–158 characters."
msgstr "۱۲۰ تا ۱۵۸ نویسه هدف‌گذاری کنید."

msgid "Duplicate meta descriptions"
msgstr "توضیحات متای تکراری"

msgid "Duplicates reduce snippet relevance."
msgstr "تکرار، ارتباط اسنیپت را کاهش می‌دهد."

msgid "Write unique descriptions."
msgstr "توضیحات یکتا بنویسید."

msgid "Missing Open Graph tags"
msgstr "تگ‌های Open Graph وجود ندارند"

msgid "Shares on social networks look broken without OG title/image."
msgstr "بدون عنوان/تصویر OG، اشتراک‌گذاری در شبکه‌های اجتماعی ناقص به نظر می‌رسد."

msgid "SEOlity can output OG tags automatically."
msgstr "سئولیتی می‌تواند تگ‌های OG را خودکار خروجی دهد."

msgid "Missing Twitter Card tags"
msgstr "تگ‌های Twitter Card وجود ندارند"

msgid "X/Twitter previews fall back to plain links."
msgstr "پیش‌نمایش در ایکس/توییتر به لینک ساده تبدیل می‌شود."

msgid "Enable Twitter Cards output."
msgstr "خروجی Twitter Card را فعال کنید."

msgid "Missing H1"
msgstr "H1 وجود ندارد"

msgid "The H1 tells users and Google what the page is about."
msgstr "H1 به کاربران و گوگل می‌گوید صفحه درباره چیست."

msgid "Ensure the theme prints the title as H1 or add one."
msgstr "مطمئن شوید قالب عنوان را به‌صورت H1 نمایش می‌دهد یا یکی اضافه کنید."

msgid "Multiple H1 headings"
msgstr "چند عنوان H1"

msgid "Not an error for Google, but a weak document outline for accessibility."
msgstr "برای گوگل خطا نیست، اما ساختار سند را از نظر دسترس‌پذیری ضعیف می‌کند."

msgid "Use one H1, then H2/H3."
msgstr "یک H1 و سپس H2/H3 به کار ببرید."

msgid "Long content without subheadings"
msgstr "محتوای طولانی بدون زیرعنوان"

msgid "Walls of text hurt scanning and passage ranking."
msgstr "متن‌های یکپارچه طولانی، مرور سریع و رتبه‌بندی بخش‌ها را دشوار می‌کنند."

msgid "Add descriptive H2/H3 sections."
msgstr "بخش‌های توصیفی H2/H3 اضافه کنید."

msgid "Heading levels skipped"
msgstr "سطوح عنوان جاافتاده"

msgid "Skipped levels break the outline for screen readers."
msgstr "سطوح جاافتاده ساختار را برای صفحه‌خوان‌ها به هم می‌زند."

msgid "Keep a logical heading hierarchy."
msgstr "سلسله‌مراتب منطقی عنوان‌ها را حفظ کنید."

msgid "Thin content"
msgstr "محتوای کم‌عمق"

msgid "Pages with little unique content rarely rank and can drag down site quality."
msgstr "صفحات با محتوای یکتای کم به‌ندرت رتبه می‌گیرند و می‌توانند کیفیت کل سایت را پایین بیاورند."

msgid "Expand with genuinely helpful information, merge with a related page, or noindex."
msgstr "با اطلاعات واقعاً مفید گسترش دهید، با صفحه مرتبط ادغام کنید یا نوایندکس کنید."

msgid "Duplicate content"
msgstr "محتوای تکراری"

msgid "Identical pages split signals; Google picks one at random."
msgstr "صفحات یکسان سیگنال‌ها را تقسیم می‌کنند؛ گوگل یکی را تصادفی انتخاب می‌کند."

msgid "Canonicalize, merge or rewrite."
msgstr "کنونیکال، ادغام یا بازنویسی کنید."

msgid "Near-duplicate content"
msgstr "محتوای تقریباً تکراری"

msgid "Very similar pages may cannibalize each other."
msgstr "صفحات بسیار مشابه ممکن است رقیب هم شوند."

msgid "Differentiate the intent of each page or consolidate."
msgstr "هدف هر صفحه را متمایز کنید یا آن‌ها را یکی کنید."

msgid "Keyword cannibalization"
msgstr "هم‌نوع‌خواری کلمه کلیدی"

msgid "Several URLs compete for the same query, diluting rankings."
msgstr "چند URL برای یک کوئری رقابت می‌کنند و رتبه‌ها تضعیف می‌شود."

msgid "Merge, redirect, differentiate or re-target."
msgstr "ادغام، ریدایرکت، متمایزسازی یا تغییر هدف."

msgid "Content may depend on JavaScript"
msgstr "محتوا ممکن است به جاوااسکریپت وابسته باشد"

msgid "Very little text in the HTML but many scripts — content rendered client-side may be indexed late or not at all."
msgstr "متن بسیار کمی در HTML و اسکریپت‌های زیاد — محتوای رندرشده در مرورگر ممکن است دیر یا اصلاً ایندکس نشود."

msgid "Server-render important content."
msgstr "محتوای مهم را سمت سرور رندر کنید."

msgid "Broken internal links"
msgstr "لینک‌های داخلی خراب"

msgid "Links to 404 pages waste crawl budget and frustrate users."
msgstr "لینک به صفحات ۴۰۴ بودجه خزش را هدر می‌دهد و کاربران را ناامید می‌کند."

msgid "Fix the link or redirect the target."
msgstr "لینک را اصلاح یا مقصد را ریدایرکت کنید."

msgid "Internal links pointing to redirects"
msgstr "لینک‌های داخلی به ریدایرکت‌ها"

msgid "Extra hops slow crawling and users."
msgstr "پرش‌های اضافی خزش و کاربران را کند می‌کنند."

msgid "Link directly to the final URL."
msgstr "مستقیماً به URL نهایی لینک دهید."

msgid "Broken external links"
msgstr "لینک‌های خارجی خراب"

msgid "Links to dead external pages hurt UX and trust."
msgstr "لینک به صفحات خارجی ازکارافتاده تجربه کاربری و اعتماد را کاهش می‌دهد."

msgid "Update or remove the outdated links."
msgstr "لینک‌های قدیمی را به‌روز یا حذف کنید."

msgid "Orphan pages (no internal links)"
msgstr "صفحات یتیم (بدون لینک داخلی)"

msgid "Pages without internal links are hard to discover and seem unimportant."
msgstr "صفحات بدون لینک داخلی سخت کشف می‌شوند و کم‌اهمیت به نظر می‌رسند."

msgid "Link to them from relevant pages (SEOlity → Internal Links)."
msgstr "از صفحات مرتبط به آن‌ها لینک دهید (سئولیتی ← لینک‌های داخلی)."

msgid "Pages deeper than 4 clicks"
msgstr "صفحات عمیق‌تر از ۴ کلیک"

msgid "Deep pages get crawled less often and receive less internal PageRank."
msgstr "صفحات عمیق کمتر خزش می‌شوند و اعتبار داخلی کمتری می‌گیرند."

msgid "Improve navigation, hubs and internal links."
msgstr "ناوبری، صفحات هاب و لینک‌های داخلی را بهبود دهید."

msgid "Excessive links on page"
msgstr "لینک‌های بیش از حد در صفحه"

msgid "Hundreds of links dilute value and overwhelm users."
msgstr "صدها لینک ارزش را رقیق و کاربران را سردرگم می‌کند."

msgid "Trim mega-menus/footers."
msgstr "مگامنوها/فوترها را خلاصه کنید."

msgid "Images without ALT text"
msgstr "تصاویر بدون متن ALT"

msgid "ALT text is required for accessibility and helps image search."
msgstr "متن ALT برای دسترس‌پذیری ضروری است و به جستجوی تصاویر کمک می‌کند."

msgid "Generate descriptive ALT text (SEOlity → Images)."
msgstr "متن ALT توصیفی تولید کنید (سئولیتی ← تصاویر)."

msgid "Broken images"
msgstr "تصاویر خراب"

msgid "Broken images look unprofessional and waste requests."
msgstr "تصاویر خراب غیرحرفه‌ای به نظر می‌رسند و درخواست‌ها را هدر می‌دهند."

msgid "Re-upload or remove the image."
msgstr "تصویر را دوباره بارگذاری یا حذف کنید."

msgid "Images without width/height"
msgstr "تصاویر بدون عرض/ارتفاع"

msgid "Missing dimensions cause layout shift (CLS)."
msgstr "نبود ابعاد باعث جابه‌جایی چیدمان (CLS) می‌شود."

msgid "Set width and height attributes."
msgstr "ویژگی‌های width و height را تنظیم کنید."

msgid "No structured data"
msgstr "بدون داده ساختاریافته"

msgid "Structured data enables rich results and helps entity understanding."
msgstr "داده ساختاریافته نتایج غنی را ممکن می‌کند و به درک موجودیت‌ها کمک می‌کند."

msgid "Enable SEOlity schema output."
msgstr "خروجی اسکیمای سئولیتی را فعال کنید."

msgid "Invalid JSON-LD"
msgstr "JSON-LD نامعتبر"

msgid "Invalid structured data is ignored by Google."
msgstr "داده ساختاریافته نامعتبر توسط گوگل نادیده گرفته می‌شود."

msgid "Fix the JSON syntax."
msgstr "نحو JSON را اصلاح کنید."

msgid "Product pages without Product schema"
msgstr "صفحات محصول بدون اسکیمای Product"

msgid "Product rich results (price, stock, rating) increase CTR."
msgstr "نتایج غنی محصول (قیمت، موجودی، امتیاز) CTR را افزایش می‌دهند."

msgid "Enable Product schema."
msgstr "اسکیمای Product را فعال کنید."

msgid "No breadcrumbs"
msgstr "بدون مسیر راهنما (بردکرامب)"

msgid "Breadcrumbs improve navigation and SERP display."
msgstr "مسیر راهنما ناوبری و نمایش در نتایج را بهبود می‌دهد."

msgid "Enable BreadcrumbList schema / breadcrumbs."
msgstr "اسکیمای BreadcrumbList / مسیر راهنما را فعال کنید."

msgid "Pages not served over HTTPS"
msgstr "صفحات بدون HTTPS"

msgid "HTTPS is a ranking signal and required for trust."
msgstr "HTTPS یک سیگنال رتبه‌بندی و لازمه اعتماد است."

msgid "Install SSL and redirect HTTP → HTTPS."
msgstr "SSL نصب کرده و HTTP را به HTTPS ریدایرکت کنید."

msgid "Mixed content (HTTP resources on HTTPS)"
msgstr "محتوای ترکیبی (منابع HTTP در HTTPS)"

msgid "Browsers block or warn on insecure resources."
msgstr "مرورگرها منابع ناامن را مسدود می‌کنند یا هشدار می‌دهند."

msgid "Load all resources over HTTPS."
msgstr "همه منابع را از طریق HTTPS بارگذاری کنید."

msgid "Missing viewport meta (not mobile-friendly)"
msgstr "متای viewport وجود ندارد (سازگار با موبایل نیست)"

msgid "Google uses mobile-first indexing."
msgstr "گوگل از ایندکس موبایل‌محور استفاده می‌کند."

msgid "Add <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">."
msgstr "تگ <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"> را اضافه کنید."

msgid "Missing html lang attribute"
msgstr "ویژگی lang در html وجود ندارد"

msgid "Helps search engines and screen readers pick the right language."
msgstr "به موتورهای جستجو و صفحه‌خوان‌ها در تشخیص زبان درست کمک می‌کند."

msgid "Set the site language in Settings → General."
msgstr "زبان سایت را در تنظیمات ← عمومی تنظیم کنید."

msgid "Invalid hreflang annotations"
msgstr "برچسب‌های hreflang نامعتبر"

msgid "Broken hreflang can show the wrong language version."
msgstr "hreflang خراب ممکن است نسخه زبانی اشتباه را نمایش دهد."

msgid "Use valid ISO codes, self-references and x-default."
msgstr "از کدهای ISO معتبر، خودارجاعی و x-default استفاده کنید."

msgid "Non-friendly URLs"
msgstr "URLهای نامناسب"

msgid "Long, parameter-heavy or uppercase URLs are harder to share and may duplicate."
msgstr "URLهای طولانی، پرپارامتر یا با حروف بزرگ سخت‌تر به اشتراک گذاشته می‌شوند و ممکن است تکراری شوند."

msgid "Use short, lowercase, hyphenated slugs (redirect old ones)."
msgstr "از نامک‌های کوتاه، با حروف کوچک و خط‌تیره استفاده کنید (قدیمی‌ها را ریدایرکت کنید)."

msgid "Slow server response (TTFB)"
msgstr "پاسخ کند سرور (TTFB)"

msgid "Slow responses hurt Core Web Vitals and crawl rate."
msgstr "پاسخ‌های کند به Core Web Vitals و نرخ خزش آسیب می‌زنند."

msgid "Enable page caching, upgrade hosting, reduce plugins."
msgstr "کش صفحه را فعال کنید، هاست را ارتقا دهید و افزونه‌ها را کم کنید."

msgid "Very large HTML document"
msgstr "سند HTML بسیار بزرگ"

msgid "Heavy HTML slows rendering on mobile."
msgstr "HTML سنگین رندر را در موبایل کند می‌کند."

msgid "Reduce inline code and DOM size."
msgstr "کدهای درون‌خطی و اندازه DOM را کاهش دهید."

msgid "Poor Core Web Vitals"
msgstr "Core Web Vitals ضعیف"

msgid "Poor LCP/INP/CLS hurt UX and are part of page experience signals."
msgstr "LCP/INP/CLS ضعیف به تجربه کاربری آسیب می‌زند و بخشی از سیگنال‌های تجربه صفحه است."

msgid "Optimize images, fonts, scripts and caching."
msgstr "تصاویر، فونت‌ها، اسکریپت‌ها و کش را بهینه کنید."

#, php-format
msgid "%1$d media library images have no ALT text (%2$d products affected)"
msgstr "%1$d تصویر کتابخانه رسانه متن ALT ندارند (%2$d محصول درگیر)"

msgid "Images without ALT text are invisible to screen readers and Google Images."
msgstr "تصاویر بدون ALT برای صفحه‌خوان‌ها و گوگل ایمیجز نامرئی هستند."

msgid "Use Bulk Optimize ALT — SEOlity writes context-aware ALT text from product/page data."
msgstr "از بهینه‌سازی گروهی ALT استفاده کنید — سئولیتی از داده‌های محصول/صفحه ALT متناسب می‌نویسد."

#, php-format
msgid "%d 404 URLs are linked from your own pages"
msgstr "%d URL با خطای ۴۰۴ از صفحات خود سایت لینک شده‌اند"

msgid "Visitors and crawlers keep hitting dead ends from inside your site."
msgstr "بازدیدکنندگان و خزنده‌ها از داخل سایت به بن‌بست می‌رسند."

msgid "Redirect them to the suggested targets (SEOlity → 404) and fix the source links."
msgstr "آن‌ها را به مقاصد پیشنهادی ریدایرکت کنید (سئولیتی ← ۴۰۴) و لینک‌های مبدأ را اصلاح کنید."

#, php-format
msgid "%d queries have several of your pages competing for them"
msgstr "برای %d کوئری چند صفحه شما با هم رقابت می‌کنند"

msgid "Competing URLs split clicks and links, so none of them ranks as well as one strong page would."
msgstr "URLهای رقیب کلیک‌ها و لینک‌ها را تقسیم می‌کنند، پس هیچ‌کدام به خوبی یک صفحه قوی رتبه نمی‌گیرند."

msgid "Merge, redirect, differentiate or re-target (AI advice per query in Keywords → Cannibalization)."
msgstr "ادغام، ریدایرکت، متمایزسازی یا تغییر هدف (مشاوره هوش مصنوعی برای هر کوئری در کلمات کلیدی ← هم‌نوع‌خواری)."

#, php-format
msgid "%1$d pages have CTR far below expected for their position (≈%2$d extra clicks/month possible)"
msgstr "%1$d صفحه CTR بسیار کمتر از انتظار جایگاهشان دارند (امکان حدود %2$d کلیک اضافه در ماه)"

msgid "Google already shows these pages, but searchers do not click — titles/descriptions don't match the intent or don't stand out."
msgstr "گوگل این صفحات را نمایش می‌دهد اما کاربران کلیک نمی‌کنند — عنوان/توضیحات با هدف جستجو منطبق نیست یا جلب توجه نمی‌کند."

msgid "Rewrite title + meta description with SEOlity (based on the real queries)."
msgstr "عنوان و توضیحات متا را با سئولیتی بازنویسی کنید (بر اساس کوئری‌های واقعی)."

#, php-format
msgid "%d products have no short description"
msgstr "%d محصول توضیحات کوتاه ندارند"

msgid "The short description is the most visible sales copy on product pages and is often used as snippet text."
msgstr "توضیحات کوتاه دیده‌شده‌ترین متن فروش در صفحه محصول است و اغلب به‌عنوان اسنیپت استفاده می‌شود."

msgid "Generate benefit-focused short descriptions with AI Product Optimizer."
msgstr "با بهینه‌ساز هوشمند محصول، توضیحات کوتاه مزیت‌محور تولید کنید."

#, php-format
msgid "Affected pages earn ~%d clicks / 28 days — fixing protects and grows that traffic."
msgstr "صفحات درگیر حدود %d کلیک در ۲۸ روز دارند — رفع مشکل این ترافیک را حفظ و تقویت می‌کند."

msgid "Blocks indexing or user access — fix first."
msgstr "مانع ایندکس یا دسترسی کاربر است — اول این را رفع کنید."

msgid "Likely ranking/CTR impact."
msgstr "احتمالاً بر رتبه/CTR تأثیر دارد."

msgid "Incremental quality improvement."
msgstr "بهبود تدریجی کیفیت."

msgid "Not enough search impressions to judge the effect."
msgstr "نمایش جستجوی کافی برای قضاوت درباره اثر وجود ندارد."

#, php-format
msgid "Clicks %1$s%%, CTR %2$s%%, position %3$s vs. before; site-wide clicks changed %4$s%% in the same period (control)."
msgstr "کلیک‌ها %1$s%%، CTR %2$s%%، جایگاه %3$s نسبت به قبل؛ کلیک‌های کل سایت در همین دوره %4$s%% تغییر کرد (گروه کنترل)."

#, php-format
msgid "Experiment had a negative effect: %s"
msgstr "آزمایش اثر منفی داشت: %s"

msgid "You can revert the change from Experiments."
msgstr "می‌توانید تغییر را از بخش آزمایش‌ها بازگردانید."

